+JsValueRef GameScriptingObject::executeCommand(JsValueRef callee, bool isConstructor, JsValueRef* arguments,
+                                               unsigned short argCount, void* callbackState) {
+    if (!Chakra::VerifyArgCount(argCount, 2)) return Chakra::GetUndefined();
+    if (!Chakra::VerifyParameters({ { arguments[1], JsValueType::JsString } })) return JS_INVALID_REFERENCE;
+    auto str = util::WStrToStr(Chakra::GetString(arguments[1]));
+
+    if (str.size() > 250 || str.size() < 1 || str.at(0) != '/') return Chakra::GetUndefined();
+
+    auto lp = SDK::ClientInstance::get()->getLocalPlayer();
+    if (lp) {
+        auto pkt = SDK::MinecraftPackets::createPacket(SDK::PacketID::COMMAND_REQUEST);
+        SDK::CommandRequestPacket* cmd = reinterpret_cast<SDK::CommandRequestPacket*>(pkt.get());
+        cmd->applyCommand(util::WStrToStr(Chakra::GetString(arguments[1])));
+
+        lp->packetSender->sendToServer(pkt.get());
+    }
+    return Chakra::GetUndefined();
+}
